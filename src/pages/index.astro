---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import HeroVideo from "../components/HeroVideo.astro";
import SectionDivider from "../components/SectionDivider.astro";
---
<BaseLayout title="Site">
  <Header />
  <main>
    <HeroVideo />
    <SectionDivider height={120} />

    <section id="music" class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-3xl font-semibold">Music</h2>
      <div class="mt-6">
        <a class="rounded-full bg-white/10 px-6 py-3 hover:bg-white/20" href="#">
          Listen now
        </a>
      </div>
    </section>


    <section id="video" class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-3xl font-semibold">Video</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <a class="group rounded-2xl bg-white/5 p-4 hover:bg-white/10" href="#">
          <div class="aspect-video w-full rounded-xl bg-white/10"></div>
          <div class="mt-3 text-sm text-white/80 group-hover:text-white">Video title</div>
        </a>
      </div>
    </section>

    <section id="tour" class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-3xl font-semibold">Tour</h2>
      <div class="mt-8 space-y-3 text-white/80">
        <div class="flex items-center justify-between rounded-2xl bg-white/5 p-4">
          <span>2026-03-10 • City</span>
          <a class="rounded-full bg-white/10 px-4 py-2 hover:bg-white/20" href="#">Tickets</a>
        </div>
      </div>
    </section>

    <section id="signup" class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-3xl font-semibold">Sign up</h2>
      <p class="mt-3 text-white/70">Оставьте контакты — отправим новости.</p>

      <form class="mt-8 grid gap-4 sm:max-w-md" method="post" action="/api/lead">
        <input class="rounded-2xl bg-white/5 px-4 py-3 outline-none ring-1 ring-white/10 focus:ring-white/30" name="email" type="email" placeholder="Email" required />
        <input class="hidden" name="company" tabIndex="-1" autocomplete="off" />
        <button class="rounded-2xl bg-white px-4 py-3 text-black hover:bg-white/90" type="submit">
          Submit
        </button>
      </form>
    </section>

    <footer class="px-6 py-10 text-center text-xs text-white/50">
      © 2026
    </footer>
  </main>
</BaseLayout>
