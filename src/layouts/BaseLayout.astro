---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Казаки делают хиты",
  description =
    "Казачьи каверы на популярные хиты: ансамбль «Любо-Мило» и Мария Лапшина. Синглы, клипы и концерты проекта при поддержке Президентского фонда культурных инициатив.",
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <!-- Векторного логотипа нет: фавиконки — PNG из исходника 3000 px (favicon.svg был PNG в обёртке на 8 МБ) -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/unbounded-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Анимации появления (data-reveal) включаются только при работающем JS -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class="bg-black text-white antialiased">
    <slot />

    <script>
      import { initReveal } from "../lib/reveal";

      initReveal();
    </script>
  </body>
</html>
