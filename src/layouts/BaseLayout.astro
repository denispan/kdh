---
const { title = "Site" } = Astro.props;
import "../styles/global.css";
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="bg-black text-white antialiased">
    <slot />
  </body>
</html>
