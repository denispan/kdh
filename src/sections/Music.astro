---
import FeaturedRelease from "../components/FeaturedRelease.astro";
import Slider from "../components/Slider.astro";
import TrackCard from "../components/TrackCard.astro";
import { tracks, type Track } from "../data/music";
import { findRelease, latestRelease } from "../data/releases";

// Рядов на слайде всегда 3, меняется число колонок:
// база — 1 колонка (3 песни), sm — 2 колонки (6), lg — 3 колонки (9).
const PER_SLIDE_BY_BP = [3, 6, 9];
const COLS_BY_BP = [1, 2, 3];

// Сервер рендерит десктопную раскладку; на клиенте слайдер пересобирает её под брейкпоинт.
const PER_SLIDE = PER_SLIDE_BY_BP[2];
const pages: Track[][] = Array.from(
  { length: Math.ceil(tracks.length / PER_SLIDE) },
  (_, i) => tracks.slice(i * PER_SLIDE, (i + 1) * PER_SLIDE),
);

const latest = latestRelease(tracks.map((t) => t.title));
const latestTrack = latest ? tracks.find((t) => findRelease(t.title)?.id === latest.id) : undefined;

---

<section id="music" class="relative overflow-hidden py-20 sm:py-24">
  <!-- фиолетовая подложка с затемнением к верхнему и нижнему краям -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="
      background:
        linear-gradient(180deg, #000 0%, rgba(0,0,0,0.35) 25%, rgba(0,0,0,0) 60%),
        linear-gradient(0deg, #000 0%, rgba(0,0,0,0.35) 25%, rgba(0,0,0,0) 60%),
        #2b0f66;
    "
  ></div>

  <div class="relative mx-auto max-w-6xl px-6">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>

        <h2 class="section-title mt-3">
          Музыка
        </h2>

    </div>

    {latest && latestTrack && <FeaturedRelease track={latestTrack} release={latest} />}

    <div class="mt-10" data-reveal>
      <Slider perSlide={PER_SLIDE_BY_BP} cols={COLS_BY_BP} loop>
        {pages.map((page) => (
          <div data-slide-group class="grid min-w-0 flex-[0_0_100%] grid-cols-3 gap-4">
            {page.map((t) => (
              <TrackCard track={t} release={findRelease(t.title)} />
            ))}
          </div>
        ))}
      </Slider>
    </div>
  </div>

  <audio data-preview-audio preload="none"></audio>

  <script>
    // Превью 30 секунд: один <audio> на страницу, играет только одна кнопка.
    const audio = document.querySelector<HTMLAudioElement>("[data-preview-audio]");
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-preview]");
    let current: HTMLButtonElement | null = null;

    const setPlaying = (btn: HTMLButtonElement, playing: boolean) => {
      btn.dataset.playing = String(playing);
      btn.setAttribute("aria-pressed", String(playing));
    };

    const stop = () => {
      if (current) setPlaying(current, false);
      current = null;
      audio?.pause();
    };

    const play = async (btn: HTMLButtonElement) => {
      const src = btn.dataset.preview;
      if (!audio || !src) return;

      stop();
      audio.src = src;
      current = btn;
      setPlaying(btn, true);

      try {
        await audio.play();
      } catch {
        // Браузер запретил воспроизведение или файл недоступен — просто снимаем состояние.
        stop();
      }
    };

    for (const btn of buttons) {
      btn.addEventListener("click", () => {
        if (current === btn) stop();
        else play(btn);
      });
    }

    audio?.addEventListener("ended", stop);
    // Пауза извне (медиаклавиши). После смены src тоже приходит pause, но с currentTime 0 — его пропускаем.
    audio?.addEventListener("pause", () => {
      if (audio.currentTime > 0 && !audio.ended) stop();
    });
  </script>
</section>
