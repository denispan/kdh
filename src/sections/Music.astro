---
import Slider from "../components/Slider.astro";
import { platforms, tracks, type Track } from "../data/music";

// Рядов на слайде всегда 3, меняется число колонок:
// база — 1 колонка (3 песни), sm — 2 колонки (6), lg — 3 колонки (9).
const PER_SLIDE_BY_BP = [3, 6, 9];
const COLS_BY_BP = [1, 2, 3];

// Сервер рендерит десктопную раскладку; на клиенте слайдер пересобирает её под брейкпоинт.
const PER_SLIDE = PER_SLIDE_BY_BP[2];
const pages: Track[][] = Array.from(
  { length: Math.ceil(tracks.length / PER_SLIDE) },
  (_, i) => tracks.slice(i * PER_SLIDE, (i + 1) * PER_SLIDE),
);
---

<section id="music" class="relative py-16 overflow-hidden">
  <!-- gradient background -->
  <div
  aria-hidden="true"
  class="pointer-events-none absolute inset-0"
  style="
    background:
      /* top fade to black */
      linear-gradient(
        180deg,
        #000 0%,
        rgba(0,0,0,0.35) 25%,
        rgba(0,0,0,0) 60%
      ),
      /* bottom fade to black */
      linear-gradient(
        0deg,
        #000 0%,
        rgba(0,0,0,0.35) 25%,
        rgba(0,0,0,0) 60%
      ),
      /* solid purple base */
      #2b0f66;
  "
></div>

  <!-- subtle grain (optional) -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.08] mix-blend-overlay"
    style="
      background-image:
        radial-gradient(circle at 1px 1px, rgba(255,255,255,0.9) 1px, transparent 0);
      background-size: 3px 3px;
    "
  ></div>

  <div class="relative mx-auto max-w-6xl px-6">
    <h2 class="sr-only">Музыка</h2>
    <p class="sr-only">
      Каверы популярных хитов в оригинальном казачьем исполнении
    </p>

    <Slider perSlide={PER_SLIDE_BY_BP} cols={COLS_BY_BP}>
      {pages.map((page) => (
        <div data-slide-group class="min-w-0 flex-[0_0_100%] grid gap-6 grid-cols-3">
          {page.map((t) => (
        <article class="min-w-0 rounded-2xl border border-white/10 bg-black/20 p-5 shadow-2xl ring-1 ring-white/10 backdrop-blur">
          <div class="flex items-center gap-4">
            <img
              src={t.colorLogo}
              alt=""
              class="h-16 w-16 shrink-0 rounded-xl object-cover ring-1 ring-white/10"
              loading="lazy"
              decoding="async"
            />

            <div class="min-w-0 flex-1">
              <h3 class="truncate text-lg font-medium">{t.title}</h3>

              <div class="mt-3 flex items-center gap-2">
                {platforms.filter((p) => t.links[p.key]).map((p) => (
                  <a
                    href={t.links[p.key]}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${t.title} — ${p.label}`}
                    class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-black/30 ring-1 ring-white/10 transition hover:bg-black/45"
                  >
                    <img
                      src={p.iconSrc}
                      alt=""
                      class="h-5 w-5 object-contain opacity-90"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ))}
              </div>
            </div>
          </div>
        </article>
          ))}
        </div>
      ))}
    </Slider>
  </div>
</section>