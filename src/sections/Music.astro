---
const tracks = [
  { title: "Где-то", colorLogo: "/logo-color/blue-pink.png" },
  { title: "Ты сделана из огня", colorLogo: "/logo-color/red.png" },
  { title: "Если ты со мной", colorLogo: "/logo-color/blue.png" },
  { title: "Мой ненаглядный", colorLogo: "/logo-color/pink.png" },
  { title: "Желанная", colorLogo: "/logo-color/green.png" },
  { title: "Ребята с нашего двора", colorLogo: "/logo-color/purple.png" },
  { title: "Облака", colorLogo: "/logo-color/orange.png" },
  { title: "Никто не услышит", colorLogo: "/logo-color/yellow.png" },
  { title: "Нарисуй мне небо", colorLogo: "/logo-color/mint.png" },
];

const platformLinks = [
  { key: "yandex", label: "Yandex Music", href: "#", iconSrc: "/icons/music-yandex.png" },
  { key: "vk", label: "VK Music", href: "#", iconSrc: "/icons/vk-music.png" },
  { key: "zvuk", label: "Звук", href: "#", iconSrc: "/icons/zvuk-music.png" },
  { key: "mts", label: "МТС Music", href: "#", iconSrc: "/icons/music-mts.png" },
];
---

<section id="music" class="relative py-16 overflow-hidden">
  <!-- gradient background -->
  <div
  aria-hidden="true"
  class="pointer-events-none absolute inset-0"
  style="
    background:
      /* top fade to black */
      linear-gradient(
        180deg,
        #000 0%,
        rgba(0,0,0,0.35) 25%,
        rgba(0,0,0,0) 60%
      ),
      /* bottom fade to black */
      linear-gradient(
        0deg,
        #000 0%,
        rgba(0,0,0,0.35) 25%,
        rgba(0,0,0,0) 60%
      ),
      /* solid purple base */
      #2b0f66;
  "
></div>

  <!-- subtle grain (optional) -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.08] mix-blend-overlay"
    style="
      background-image:
        radial-gradient(circle at 1px 1px, rgba(255,255,255,0.9) 1px, transparent 0);
      background-size: 3px 3px;
    "
  ></div>

  <div class="relative mx-auto max-w-6xl px-6">
    <h2 class="sr-only">Музыка</h2>
    <p class="sr-only">
      Каверы популярных хитов в оригинальном казачьем исполнении
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {tracks.map((t) => (
        <article class="rounded-2xl border border-white/10 bg-black/20 p-5 shadow-2xl ring-1 ring-white/10 backdrop-blur">
          <div class="flex items-center gap-4">
            <img
              src={t.colorLogo}
              alt=""
              class="h-16 w-16 shrink-0 rounded-xl object-cover ring-1 ring-white/10"
              loading="lazy"
              decoding="async"
            />

            <div class="min-w-0 flex-1">
              <h3 class="truncate text-lg font-medium">{t.title}</h3>

              <div class="mt-3 flex items-center gap-2">
                {platformLinks.map((p) => (
                  <a
                    href={p.href}
                    aria-label={p.label}
                    class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-black/30 ring-1 ring-white/10 transition hover:bg-black/45"
                  >
                    <img
                      src={p.iconSrc}
                      alt={p.label}
                      class="h-5 w-5 object-contain opacity-90"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>