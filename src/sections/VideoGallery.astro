---
import { videos } from "../data/videos";
---

<section id="videos" class="py-16">
  <div class="relative mx-auto max-w-6xl px-6">
    <h2 class="sr-only">Видео</h2>

    <div class="mt-10 grid gap-12 sm:grid-cols-1 lg:grid-cols-2">
      {videos.map((video) => (
        <article class="group relative overflow-hidden rounded-2xl border border-white/10 bg-black/20 shadow-2xl ring-1 ring-white/10 backdrop-blur">
          <button
            type="button"
            data-video-src={video.src}
            class="relative block w-full cursor-pointer"
          >
            <div class="relative aspect-video w-full overflow-hidden bg-black">
              <img
                src={video.thumbnail}
                alt={video.title}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20"></div>
              
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="rounded-full bg-white/20 p-6 backdrop-blur-sm transition-transform group-hover:scale-110">
                  <svg class="h-12 w-12 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>

              <div class="absolute bottom-0 left-0 right-0 p-4">
                <h3 class="text-lg font-medium text-white">{video.title}</h3>
              </div>
            </div>
          </button>
        </article>
      ))}
    </div>
  </div>

  <dialog
    class="backdrop:bg-black/80 bg-transparent p-0 m-0 max-w-none w-[90vw] h-[90svh]"
    data-video-modal
  >
    <div class="relative h-full w-full rounded-2xl border border-white/15 bg-black/20 shadow-2xl ring-1 ring-white/10 backdrop-blur">
      <button
        type="button"
        class="absolute right-4 top-4 z-50 rounded-full bg-white/10 px-4 py-2 text-white hover:bg-white/20 cursor-pointer"
        data-video-close
      >
        Закрыть
      </button>

      <div class="h-full w-full rounded-2xl overflow-hidden">
        <iframe
          data-video-iframe
          width="100%"
          height="100%"
          allow="autoplay; encrypted-media; fullscreen; picture-in-picture; screen-wake-lock;"
          frameborder="0"
          allowfullscreen
          class="rounded-2xl"
        ></iframe>
      </div>
    </div>
  </dialog>

  <style>
    dialog[data-video-modal] {
      position: fixed;
      inset: 50% auto auto 50%;
      transform: translate(-50%, -50%);
    }
  </style>

  <script>
    const modal = document.querySelector<HTMLDialogElement>("[data-video-modal]");
    const modalIframe = document.querySelector<HTMLIFrameElement>("[data-video-iframe]");
    const closeBtn = document.querySelector("[data-video-close]");

    const open = (src: string) => {
      if (!modalIframe || !modal) {
        return;
      }
      modalIframe.src = src;
      modal.showModal();
    };

    const close = () => {
      if (!modalIframe || !modal) {
        return;
      }
      modal.close();
      modalIframe.src = "";
    };

    closeBtn?.addEventListener("click", close);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) {
        close();
      }
    });

    document.querySelectorAll<HTMLButtonElement>("button[data-video-src]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = btn.dataset.videoSrc;
        if (src) {
          open(src);
        }
      });
    });
  </script>
</section>
