---
import SocialIcon from "../components/SocialIcon.astro";
import { socialLinks, streamingLinks } from "../data/social";

const contacts = [
  {
    title: "Сотрудничество",
    name: "Антон Казак",
    phone: "+7 (952) 212-45-52",
    phoneHref: "tel:+79522124552",
    email: "akazakmsk@gmail.com",
  },
  {
    title: "Концерты",
    name: "Мария Громова",
    phone: "+7 (903) 752-13-08",
    phoneHref: "tel:+79037521308",
    email: "7521308@gmail.com",
  },
];

const year = new Date().getFullYear();
---

<footer id="contacts" class="border-t border-white/10 bg-white/5">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-12 md:grid-cols-[1fr_1fr_auto]">
      {contacts.map((c) => (
        <div>
          <h3 class="eyebrow">{c.title}</h3>
          <p class="mt-4 font-display text-lg font-bold">{c.name}</p>
          <div class="mt-2 space-y-1 text-sm text-white/80">
            <a href={c.phoneHref} class="block transition hover:text-white">{c.phone}</a>
            <a href={`mailto:${c.email}`} class="block transition hover:text-white">{c.email}</a>
          </div>
        </div>
      ))}

      <div>
        <h3 class="eyebrow">Соцсети</h3>
        <ul class="mt-4 flex gap-3">
          {socialLinks.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                title={s.label}
                class="grid h-11 w-11 place-items-center rounded-full text-white opacity-85 transition hover:opacity-100"
              >
                <SocialIcon name={s.icon} class="h-7 w-7" />
              </a>
            </li>
          ))}
        </ul>

        <h3 class="eyebrow mt-8">Слушать</h3>
        <ul class="mt-4 flex max-w-xs flex-wrap gap-2">
          {streamingLinks.map((l) => (
            <li>
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-2 rounded-full border border-white/15 px-3 py-1.5 text-xs text-white/80 transition hover:border-white/40 hover:text-white"
              >
                {l.iconSrc && (
                  <img
                    src={l.iconSrc}
                    alt=""
                    class="h-4 w-4 object-contain grayscale transition group-hover:grayscale-0"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs text-white/50">
      <span>© {year} Казаки делают хиты</span>
      <span>Проект реализуется при поддержке Президентского фонда культурных инициатив</span>
    </div>
  </div>
</footer>
