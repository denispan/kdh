---
import GallerySlider from "../components/GallerySlider.astro";
import { photos } from "../data/photos";
---

<section id="photos" class="py-8 overflow-x-clip">

    <h2 class="text-center text-3xl font-semibold uppercase tracking-[0.12em]">Фото</h2>


  <!-- full-bleed slider -->
  <div class="mt-8 relative left-1/2 right-1/2 w-screen -ml-[50vw] -mr-[50vw] overflow-x-clip">
    <GallerySlider images={photos} />
  </div>

  <!-- modal -->
  <dialog
    class="backdrop:bg-black/80 bg-transparent p-0 m-0 max-w-none w-[80vw] h-[80svh]"
    data-gallery-modal
  >
    <div class="relative h-full w-full rounded-2xl border border-white/15 bg-black/20 shadow-2xl ring-1 ring-white/10 backdrop-blur">
      <button
        type="button"
        class="absolute right-4 top-4 z-50 rounded-full bg-white/10 px-4 py-2 text-white hover:bg-white/20 cursor-pointer"
        data-gallery-close
      >
        Закрыть
      </button>

      <img
        alt=""
        class="h-full w-full rounded-2xl object-contain"
        data-gallery-image
      />
    </div>
  </dialog>

  <style>
    dialog[data-gallery-modal] {
      position: fixed;
      inset: 50% auto auto 50%;
      transform: translate(-50%, -50%);
    }
  </style>

  <script>
    const modal = document.querySelector<HTMLDialogElement>("[data-gallery-modal]");
    const modalImg = document.querySelector<HTMLImageElement>("[data-gallery-image]");
    const closeBtn = document.querySelector("[data-gallery-close]");

    const open = (src: string) => {
      if (!modalImg || !modal) return;
      modalImg.src = src;
      modal.showModal();
    };

    const close = () => modal?.close();

    closeBtn?.addEventListener("click", close);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) close();
    });

    window.addEventListener("gallery:open", ((e: CustomEvent) => {
      open(e.detail?.src);
    }) as EventListener);
  </script>
</section>