---
import { photos, type Photo } from "../data/photos";

// Две ленты, идущие навстречу друг другу: чётные фото — в одной, нечётные — в другой.
const rows: Photo[][] = [photos.filter((_, i) => i % 2 === 0), photos.filter((_, i) => i % 2 === 1)];

// Три слота просмотра: предыдущее, текущее, следующее — лента сдвигается на один слот.
const slots = ["prev", "current", "next"] as const;
---

<section id="photos" class="relative overflow-hidden py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6" data-reveal>
    <h2 class="section-title mt-3">
      Фото
    </h2>
  </div>

  <div class="mt-10 space-y-4" data-reveal style="--reveal-delay: 120ms">
    {rows.map((row, rowIndex) => (
      <div class="marquee" style={`--marquee-duration: ${90 + rowIndex * 25}s`}>
        <div class="marquee-track gap-4 pr-4" data-direction={rowIndex === 1 ? "reverse" : undefined}>
          {[false, true].map((clone) => (
            <ul class="flex shrink-0 gap-4" data-clone={clone ? "" : undefined} aria-hidden={clone ? "true" : undefined}>
              {row.map((photo, i) => (
                <li class="shrink-0">
                  <button
                    type="button"
                    class="block h-44 cursor-pointer overflow-hidden rounded-xl ring-1 ring-white/10 transition duration-300 hover:scale-[1.03] hover:ring-white/40 sm:h-56 lg:h-64"
                    style={`background-color: ${photo.color}; aspect-ratio: ${photo.width} / ${photo.height}`}
                    data-photo={photo.full}
                    data-photo-index={i * 2 + rowIndex}
                    tabindex={clone ? -1 : undefined}
                    aria-label="Открыть фото"
                  >
                    <img
                      src={photo.thumb}
                      alt="Казаки делают хиты — фото с концертов и съёмок"
                      width={photo.width}
                      height={photo.height}
                      class="h-full w-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Просмотр фото: лента из трёх слотов едет за пальцем и доезжает плавно; стрелки, ←/→, фон заблокирован -->
  <dialog
    class="m-0 h-svh max-h-none w-screen max-w-none bg-transparent p-0 backdrop:bg-black/90"
    data-gallery-modal
    aria-label="Просмотр фото"
  >
    <div class="relative h-full w-full touch-pan-y overflow-hidden select-none" data-gallery-stage>
      <button
        type="button"
        class="absolute right-4 top-4 z-20 cursor-pointer rounded-full bg-white/10 px-4 py-2 text-sm text-white backdrop-blur transition hover:bg-white/20"
        data-gallery-close
      >
        Закрыть
      </button>

      <div class="absolute left-4 top-4 z-20 rounded-full bg-black/50 px-3 py-1.5 text-xs text-white/80 tabular-nums backdrop-blur" data-gallery-counter></div>

      <button
        type="button"
        class="absolute left-2 top-1/2 z-20 hidden h-12 w-12 -translate-y-1/2 cursor-pointer place-items-center rounded-full bg-white/10 text-white backdrop-blur transition hover:bg-white/25 sm:grid sm:left-4"
        data-gallery-prev
        aria-label="Предыдущее фото"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M15 5l-7 7 7 7" />
        </svg>
      </button>

      <button
        type="button"
        class="absolute right-2 top-1/2 z-20 hidden h-12 w-12 -translate-y-1/2 cursor-pointer place-items-center rounded-full bg-white/10 text-white backdrop-blur transition hover:bg-white/25 sm:grid sm:right-4"
        data-gallery-next
        aria-label="Следующее фото"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <div class="flex h-full w-full will-change-transform" style="transform: translateX(-100%)" data-gallery-track>
        {slots.map((slot) => (
          <div class="flex h-full w-full shrink-0 items-center justify-center" data-gallery-slot={slot}>
            <img
              alt="Казаки делают хиты — фото с концертов и съёмок"
              class="max-h-[88svh] max-w-[94vw] rounded-xl object-contain shadow-2xl sm:max-w-[84vw]"
              draggable="false"
            />
          </div>
        ))}
      </div>
    </div>
  </dialog>

  <script>
    const SWIPE_THRESHOLD_PX = 40;
    const SLIDE_MS = 320;
    const SLIDE_EASING = "cubic-bezier(0.2, 0.7, 0.2, 1)";

    const modal = document.querySelector<HTMLDialogElement>("[data-gallery-modal]");
    const stage = modal?.querySelector<HTMLElement>("[data-gallery-stage]") ?? null;
    const track = modal?.querySelector<HTMLElement>("[data-gallery-track]") ?? null;
    const counter = modal?.querySelector<HTMLElement>("[data-gallery-counter]") ?? null;
    const slotImages = {
      prev: modal?.querySelector<HTMLImageElement>("[data-gallery-slot='prev'] img") ?? null,
      current: modal?.querySelector<HTMLImageElement>("[data-gallery-slot='current'] img") ?? null,
      next: modal?.querySelector<HTMLImageElement>("[data-gallery-slot='next'] img") ?? null,
    };

    // Порядок фото — как в data/photos.ts (индекс лежит на кнопках превью).
    const sources: string[] = [];
    for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-photo][data-photo-index]")) {
      const index = Number(btn.dataset.photoIndex);
      const src = btn.dataset.photo;
      if (Number.isInteger(index) && src) sources[index] = src;
    }

    let current = 0;
    let animating = false;

    const wrap = (index: number) => (index + sources.length) % sources.length;

    const setTranslate = (px: number, animate: boolean) => {
      if (!track) return;
      track.style.transition = animate ? `transform ${SLIDE_MS}ms ${SLIDE_EASING}` : "none";
      track.style.transform = `translateX(calc(-100% + ${px}px))`;
    };

    // Заполняем три слота соседями текущего фото и ставим ленту на середину.
    const render = (index: number) => {
      current = wrap(index);
      if (slotImages.prev) slotImages.prev.src = sources[wrap(current - 1)];
      if (slotImages.current) slotImages.current.src = sources[current];
      if (slotImages.next) slotImages.next.src = sources[wrap(current + 1)];
      if (counter) counter.textContent = `${current + 1} / ${sources.length}`;
      setTranslate(0, false);
    };

    // Доезжаем до соседнего слота, затем без анимации перестраиваем ленту вокруг нового текущего.
    const slideTo = (direction: -1 | 1) => {
      if (!track || animating || sources.length < 2) return;
      animating = true;
      const width = track.clientWidth;
      setTranslate(-direction * width, true);
      const finish = () => {
        track.removeEventListener("transitionend", finish);
        animating = false;
        render(current + direction);
      };
      track.addEventListener("transitionend", finish);
      // Страховка на случай, если transitionend не придёт (вкладка свернулась).
      window.setTimeout(() => {
        if (animating) finish();
      }, SLIDE_MS + 100);
    };

    const open = (index: number) => {
      if (!modal) return;
      render(index);
      modal.showModal();
      // Пока открыт просмотр, страница под ним не прокручивается.
      document.documentElement.style.overflow = "hidden";
    };

    const close = () => modal?.close();

    modal?.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
      for (const img of Object.values(slotImages)) img?.removeAttribute("src");
    });

    modal?.querySelector("[data-gallery-close]")?.addEventListener("click", close);
    modal?.querySelector("[data-gallery-prev]")?.addEventListener("click", () => slideTo(-1));
    modal?.querySelector("[data-gallery-next]")?.addEventListener("click", () => slideTo(1));

    modal?.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") slideTo(1);
      if (e.key === "ArrowLeft") slideTo(-1);
    });

    // Перетаскивание пальцем или мышью: лента едет за курсором, на отпускании доезжает или возвращается.
    let dragStartX: number | null = null;
    let dragDx = 0;

    stage?.addEventListener("pointerdown", (e) => {
      if (animating || e.button !== 0) return;
      dragStartX = e.clientX;
      dragDx = 0;
      try {
        stage.setPointerCapture(e.pointerId);
      } catch {
        // Указателя с таким id нет (синтетическое событие) — перетаскивание работает и без захвата.
      }
    });

    stage?.addEventListener("pointermove", (e) => {
      if (dragStartX === null) return;
      dragDx = e.clientX - dragStartX;
      setTranslate(dragDx, false);
    });

    const endDrag = () => {
      if (dragStartX === null) return;
      dragStartX = null;
      if (Math.abs(dragDx) >= SWIPE_THRESHOLD_PX) {
        slideTo(dragDx < 0 ? 1 : -1);
      } else {
        setTranslate(0, true);
      }
    };

    stage?.addEventListener("pointerup", endDrag);
    stage?.addEventListener("pointercancel", endDrag);

    // Клик по тёмному фону (мимо картинки и кнопок) закрывает просмотр — но не после перетаскивания.
    stage?.addEventListener("click", (e) => {
      if (Math.abs(dragDx) >= SWIPE_THRESHOLD_PX) {
        dragDx = 0;
        return;
      }
      if (e.target instanceof HTMLElement && e.target.hasAttribute("data-gallery-slot")) close();
    });

    for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-photo-index]")) {
      btn.addEventListener("click", () => {
        const index = Number(btn.dataset.photoIndex);
        if (Number.isInteger(index)) open(index);
      });
    }
  </script>
</section>
