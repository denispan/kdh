---
const tagline1 = `Такого вы&nbsp;еще&nbsp;не&nbsp;слышали!`;
const tagline2 = "а пора бы!";
---

<section class="py-20">
  <div class="mx-auto max-w-4xl px-6 text-center">
    <h2 class="text-xl xs:text-2xl sm:text-2xl md:text-3xl lg:text-4xl font-bold uppercase tracking-[0.12em]">
      <span set:html={tagline1} /><br />
      {tagline2}
    </h2>
  </div>
</section>
