---
// src/sections/Contacts.astro (или прямо в index.astro как секция)
const name = "Казак Антон";
const phone = "+7 (952) 212-45-52";
const phoneHref = "tel:+79522124552";
const email = "akazakmsk@gmail.com";
const emailHref = `mailto:${email}`;
const vkHandle = "@hit_kazak";
const vkHref = "https://vk.com/hit_kazak";

// const techRiderHref = "/riders/tech.pdf";
// const householdRiderHref = "/riders/household.pdf";

const tagline = "Такого вы еще не слышали! а пора бы!";
---

<section id="contacts" class="py-20">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-center text-3xl font-semibold uppercase tracking-[0.12em]">Контакты</h2>

    <div class="mt-10 mx-auto max-w-2xl rounded-2xl border border-white/10 bg-white/5 p-6 shadow-2xl ring-1 ring-white/10 backdrop-blur">
      <div class="text-center">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-white/80">{name}</div>
      </div>

      <div class="mt-8 space-y-5">
        <a href={phoneHref} class="flex items-center gap-4 rounded-xl px-3 py-3 hover:bg-white/5">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 ring-1 ring-white/10">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.08 4.18 2 2 0 0 1 4.06 2h3a2 2 0 0 1 2 1.72c.12.86.3 1.7.54 2.5a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.58-1.06a2 2 0 0 1 2.11-.45c.8.24 1.64.42 2.5.54A2 2 0 0 1 22 16.92z"/>
            </svg>
          </span>
          <span class="text-lg font-medium">{phone}</span>
        </a>

        <a href={emailHref} class="flex items-center gap-4 rounded-xl px-3 py-3 hover:bg-white/5">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 ring-1 ring-white/10">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16v16H4z"/>
              <path d="m4 6 8 7 8-7"/>
            </svg>
          </span>
          <span class="text-lg font-medium underline underline-offset-4 decoration-white/30 hover:decoration-white/70">
            {email}
          </span>
        </a>

        <a href={vkHref} target="_blank" rel="noreferrer" class="flex items-center gap-4 rounded-xl px-3 py-3 hover:bg-white/5">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 ring-1 ring-white/10">
            <!-- можно заменить на свой /socials/vk.svg -->
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
              <path d="M13.2 16.7c.6-.2.8-.5.8-1 0-.8-.2-1.4.4-1.8.3-.2.7-.1 1.1.2.9.7 1.4 1.6 2.5 1.6h2.5c.7 0 1.1-.2 1.3-.6.2-.4.1-.8-.2-1.2-1.2-1.6-2.4-2.8-2.4-2.8s-1 .2 1.6-2.8c.5-.6.7-1 .6-1.3-.1-.3-.4-.5-1-.5h-2.8c-.6 0-1 .2-1.2.6-.8 1.7-1.7 3.3-2.5 3.3-.3 0-.5-.3-.5-.9V6.2c0-.6-.2-.9-.8-1h-4c-.4 0-.6.1-.8.3-.2.2-.2.5 0 .7.4.4.6.6.6 1.5v3.5c0 .8-.1 1.3-.5 1.3-1 0-2.2-2.1-3.2-4.5-.2-.4-.6-.6-1.2-.6H2.6c-.7 0-1 .3-1 .8 0 .7 1 3.2 2.9 5.8 1.3 1.8 3.2 3.2 5.5 3.2h3.2z"/>
            </svg>
          </span>
          <span class="text-lg font-medium">{vkHandle}</span>
        </a>

        <!-- <a href={techRiderHref} target="_blank" rel="noreferrer" class="flex items-center gap-4 rounded-xl px-3 py-3 hover:bg-white/5">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 ring-1 ring-white/10">
            <span class="text-xs font-semibold">PDF</span>
          </span>
          <span class="text-lg font-medium">Технический райдер</span>
        </a>

        <a href={householdRiderHref} target="_blank" rel="noreferrer" class="flex items-center gap-4 rounded-xl px-3 py-3 hover:bg-white/5">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 ring-1 ring-white/10">
            <span class="text-xs font-semibold">PDF</span>
          </span>
          <span class="text-lg font-medium">Бытовой райдер</span>
        </a> -->
      </div>

      <div class="mt-10 text-center text-lg font-semibold uppercase tracking-[0.12em] text-white/90">
        {tagline}
      </div>
    </div>
  </div>
</section>