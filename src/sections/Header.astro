---
// src/sections/Header.astro
import SocialIcon from "../components/SocialIcon.astro";
import { socialLinks } from "../data/social";

const navLinks = [
  { href: "#music", label: "Музыка" },
  { href: "#photos", label: "Фото" },
  { href: "#videos", label: "Видео" },
  { href: "#contacts", label: "Контакты" },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 w-full transition-[background-color,box-shadow] duration-300 data-[menu-open=true]:bg-black/85 data-[menu-open=true]:backdrop-blur-md data-[scrolled=true]:bg-black/70 data-[scrolled=true]:shadow-[0_1px_0_rgba(255,255,255,0.08)] data-[scrolled=true]:backdrop-blur-md"
  data-header
  data-scrolled="false"
  data-menu-open="false"
>
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex h-16 items-center justify-between gap-6">
      <a href="/" class="flex h-11 shrink-0 items-center" aria-label="Казаки делают хиты — на главную">
        <!-- logo-header.webp — белый логотип без тени, 400 px, сделан из 3000-px исходника фавиконки -->
        <img
          src="/logo-header.webp"
          alt="Казаки делают хиты"
          width="400"
          height="400"
          class="h-full w-auto opacity-85"
          decoding="async"
          loading="eager"
        />
      </a>

      <nav
        class="hidden items-center gap-8 font-display text-[11px] font-semibold uppercase tracking-[0.22em] text-white/85 md:flex lg:gap-12"
        aria-label="Разделы сайта"
      >
        {navLinks.map((l) => (
          <a class="transition hover:text-white" href={l.href}>
            {l.label}
          </a>
        ))}
      </nav>

      <ul class="hidden items-center gap-2 md:flex" aria-label="Соцсети">
        {socialLinks.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              title={s.label}
              class="grid h-9 w-9 place-items-center rounded-lg bg-white/5 text-white/85 ring-1 ring-white/10 transition hover:bg-white/15 hover:text-white hover:ring-white/30"
            >
              <SocialIcon name={s.icon} class="h-4 w-4" />
            </a>
          </li>
        ))}
      </ul>

      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-white/5 ring-1 ring-white/10 hover:bg-white/10 md:hidden"
        aria-label="Меню"
        aria-expanded="false"
        data-menu-toggle
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div class="hidden md:hidden" data-mobile-menu>
    <div class="mx-auto max-w-6xl px-6 pb-6">
      <nav class="flex flex-col gap-4 font-display text-sm font-semibold uppercase tracking-[0.22em] text-white" aria-label="Разделы сайта">
        {navLinks.map((l) => (
          <a class="py-1 transition hover:text-white/60" href={l.href} data-menu-link>
            {l.label}
          </a>
        ))}
      </nav>
      <ul class="mt-6 flex items-center gap-3" aria-label="Соцсети">
        {socialLinks.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              title={s.label}
              class="grid h-11 w-11 place-items-center rounded-xl bg-white/10 text-white ring-1 ring-white/10 transition hover:bg-white/20"
              data-menu-link
            >
              <SocialIcon name={s.icon} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]") ?? null;
  const menu = header?.querySelector<HTMLElement>("[data-mobile-menu]") ?? null;

  const isMenuOpen = () => menu !== null && !menu.classList.contains("hidden");

  const setMenu = (open: boolean) => {
    if (!menu || !toggle || !header) return;
    menu.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    header.setAttribute("data-menu-open", String(open));
  };

  toggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    setMenu(!isMenuOpen());
  });

  header?.querySelectorAll("[data-menu-link]").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  document.addEventListener("click", (e) => {
    if (!header || !isMenuOpen()) return;
    if (e.target instanceof Node && !header.contains(e.target)) setMenu(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });

  // Прозрачная шапка поверх видео → тёмная плашка после прокрутки.
  const updateScrolled = () => {
    header?.setAttribute("data-scrolled", String(window.scrollY > 24));
  };

  updateScrolled();
  window.addEventListener("scroll", updateScrolled, { passive: true });
</script>
