---
const navLinks = [
  { href: "#music", label: "Музыка" },
  { href: "#photos", label: "Фото" },
  { href: "#video", label: "Видео" },
  { href: "#contacts", label: "Контакты" },
];
---

<header class="absolute inset-0 z-50 flex justify-center pt-[10%]" data-header>
  <div class="flex flex-col items-center">
    <nav class="flex flex-col items-center gap-8 text-[3.33rem] font-bold uppercase tracking-[0.22em] text-white">
        {navLinks.map((l) => (
          <a class="hover:opacity-80 transition-opacity" href={l.href}>
            {l.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>