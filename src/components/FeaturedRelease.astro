---
import { platforms, type Track } from "../data/music";
import type { Release } from "../data/releases";

type Props = {
  track: Track;
  release: Release;
};

const { track, release } = Astro.props;

const links = platforms.filter((p) => track.links[p.key]);
const releaseYear = release.releaseDate.slice(0, 4);
---

<div class="relative mt-12 overflow-hidden rounded-3xl border border-white/10 bg-black/20 shadow-2xl ring-1 ring-white/10 backdrop-blur" data-reveal>
  <div class="grid gap-8 p-6 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-10 sm:p-8 lg:p-10">
    <div class="group mx-auto w-48 sm:w-56 lg:w-64">
      <img
        src={release.cover}
        alt={`Обложка сингла «${track.title}»`}
        width="480"
        height="480"
        class="w-full rounded-2xl shadow-2xl transition duration-500 group-hover:scale-[1.02]"
        decoding="async"
      />
    </div>

    <div>
      <p class="eyebrow">Новый сингл · {releaseYear}</p>
      <h3 class="mt-3 font-display text-3xl font-extrabold uppercase leading-none text-white sm:text-4xl lg:text-5xl">
        {track.title}
      </h3>
      {track.original && <p class="mt-3 text-white/50">оригинал — {track.original}</p>}

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <!-- Те же чипы площадок, что в карточках треков -->
        <div class="flex items-center gap-2">
          {links.map((p) => (
            <a
              href={track.links[p.key]}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${track.title} — ${p.label}`}
              title={p.label}
              class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-black/30 ring-1 ring-white/10 transition hover:bg-black/45"
            >
              <img src={p.iconSrc} alt="" class="h-5 w-5 object-contain" loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
