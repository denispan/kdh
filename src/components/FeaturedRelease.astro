---
import { platforms, type Track } from "../data/music";
import type { Release } from "../data/releases";
import { isLightColor } from "../lib/color";

type Props = {
  track: Track;
  release: Release;
};

const { track, release } = Astro.props;

const tone = isLightColor(release.color)
  ? {
      text: "text-black",
      muted: "text-black/60",
      ghost: "border-black/20 bg-black/5 text-black hover:border-black/40 hover:bg-black/10",
    }
  : {
      text: "text-white",
      muted: "text-white/70",
      ghost: "border-white/25 bg-white/5 text-white hover:border-white/50 hover:bg-white/10",
    };

const links = platforms.filter((p) => track.links[p.key]);
const releaseYear = release.releaseDate.slice(0, 4);
---

<div
  class={`relative mt-12 overflow-hidden rounded-3xl ring-1 ring-white/10 ${tone.text}`}
  style={`background-color: ${release.color}`}
  data-reveal
>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white/15 via-transparent to-black/35" aria-hidden="true"></div>

  <div class="relative grid gap-8 p-6 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-10 sm:p-8 lg:p-10">
    <div class="group mx-auto w-48 sm:w-56 lg:w-64">
      <img
        src={release.cover}
        alt={`Обложка сингла «${track.title}»`}
        width="480"
        height="480"
        class="w-full -rotate-3 rounded-2xl shadow-2xl transition duration-500 group-hover:rotate-0"
        decoding="async"
      />
    </div>

    <div>
      <p class={`font-display text-[11px] font-semibold uppercase tracking-[0.3em] ${tone.muted}`}>
        Новый сингл · {releaseYear}
      </p>
      <h3 class="mt-3 font-display text-3xl font-extrabold uppercase leading-none sm:text-4xl lg:text-5xl">
        {track.title}
      </h3>
      {track.original && <p class={`mt-3 ${tone.muted}`}>оригинал — {track.original}</p>}

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <button
          type="button"
          class="btn btn-primary cursor-pointer"
          data-preview={release.preview}
          data-playing="false"
          aria-pressed="false"
          aria-label={`Послушать 30 секунд: ${track.title}`}
        >
          <svg class="play-icon h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
          <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
          30 секунд
        </button>

        {links.map((p) => (
          <a
            href={track.links[p.key]}
            target="_blank"
            rel="noopener noreferrer"
            class={`btn border backdrop-blur ${tone.ghost}`}
          >
            <img src={p.iconSrc} alt="" class="h-4 w-4 object-contain" loading="lazy" decoding="async" />
            {p.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</div>
