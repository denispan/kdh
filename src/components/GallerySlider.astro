---
const { images = [] } = Astro.props;
---

<div class="select-none w-full relative" data-gallery-slider>
  <div class="overflow-hidden w-full touch-pan-y" data-embla-viewport>
    <div class="flex" data-embla-container>
      {images.map((src: string) => (
        <div class="min-w-0 flex-[0_0_66.666%]">
          <button
            type="button"
            data-src={src}
            class="group relative block w-full overflow-hidden cursor-pointer"
          >
            <img
              src={src}
              class="h-[95svh] w-full object-cover object-top transition-transform duration-300 group-hover:scale-105 sm:h-[35rem]"
              loading="lazy"
              decoding="async"
              alt=""
            />
            <div class="pointer-events-none absolute inset-0 ring-1 ring-white/10"></div>
          </button>
        </div>
      ))}
    </div>
  </div>

  <button
    type="button"
    class="absolute left-3 top-1/2 -translate-y-1/2 rounded-full border border-white/20 bg-black/30 px-4 py-3 text-sm text-white backdrop-blur transition hover:bg-black/45 cursor-pointer"
    data-embla-prev
    aria-label="Назад"
  >
    ←
  </button>

  <button
    type="button"
    class="absolute right-3 top-1/2 -translate-y-1/2 rounded-full border border-white/20 bg-black/30 px-4 py-3 text-sm text-white backdrop-blur transition hover:bg-black/45 cursor-pointer"
    data-embla-next
    aria-label="Вперёд"
  >
    →
  </button>
</div>

<script>
  import EmblaCarousel from "embla-carousel";

  document.querySelectorAll<HTMLElement>("[data-gallery-slider]").forEach((root) => {
    const viewport = root.querySelector<HTMLElement>("[data-embla-viewport]");
    if (!viewport) return;

    const prevBtn = root.querySelector<HTMLButtonElement>("[data-embla-prev]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-embla-next]");

    const embla = EmblaCarousel(viewport, {
      loop: true,
      align: "center",
      containScroll: "trimSnaps",
      dragFree: false,
      watchDrag: true,
    });

    prevBtn?.addEventListener("click", () => embla.scrollPrev());
    nextBtn?.addEventListener("click", () => embla.scrollNext());

    let startX = 0;
    let startY = 0;
    let wasDragged = false;

    viewport.addEventListener("pointerdown", (e: PointerEvent) => {
      startX = e.clientX;
      startY = e.clientY;
      wasDragged = false;
    });

    viewport.addEventListener("pointermove", (e: PointerEvent) => {
      const dx = Math.abs(e.clientX - startX);
      const dy = Math.abs(e.clientY - startY);
      if (dx > 5 || dy > 5) {
        wasDragged = true;
      }
    });

    let wheelTimeout: number | null = null;
    let isScrolling = false;
    const SWIPE_THRESHOLD = 50;

    viewport.addEventListener("wheel", (e: WheelEvent) => {
      if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
        return;
      }

      e.preventDefault();

      if (isScrolling) {
        return;
      }

      if (Math.abs(e.deltaX) > SWIPE_THRESHOLD) {
        isScrolling = true;
        
        if (e.deltaX > 0) {
          embla.scrollNext();
        } else {
          embla.scrollPrev();
        }

        if (wheelTimeout !== null) {
          clearTimeout(wheelTimeout);
        }

        wheelTimeout = window.setTimeout(() => {
          isScrolling = false;
          wheelTimeout = null;
        }, 300);
      }
    }, { passive: false });

    root.addEventListener("click", (e: MouseEvent) => {
      const target = e.target as HTMLElement | null;
      const btn = target?.closest<HTMLButtonElement>("button[data-src]");
      if (!btn) return;
      if (wasDragged) {
        wasDragged = false;
        return;
      }
      window.dispatchEvent(new CustomEvent("gallery:open", { detail: { src: btn.dataset.src } }));
    });
  });
</script>