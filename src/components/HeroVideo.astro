    <h1 class="mt-4 text-5xl font-semibold leading-[0.95] md:text-7xl">Project title</h1>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#music" class="rounded-full bg-white/15 px-6 py-3 backdrop-blur hover:bg-white/25">
