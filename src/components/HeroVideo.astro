<section id="top" class="relative min-h-[100svh]">
  <video
    class="absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/video/hero-poster.jpg"
  >
    <source src="/video/hero.webm" type="video/webm" />
    <source src="/video/hero.mp4" type="video/mp4" />
  </video>

  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-black/10"></div>

  <div class="relative mx-auto flex min-h-[100svh] max-w-6xl flex-col justify-end px-6 pb-16">
