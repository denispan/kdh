<section id="signup" class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="text-3xl font-semibold">Sign up</h2>
    <p class="mt-3 text-white/70">Оставьте контакты — отправим новости.</p>

    <form class="mt-8 grid gap-4 sm:max-w-md" method="post" action="/api/lead">
    <input class="rounded-2xl bg-white/5 px-4 py-3 outline-none ring-1 ring-white/10 focus:ring-white/30" name="email" type="email" placeholder="Email" required />
    <input class="hidden" name="company" tabIndex="-1" autocomplete="off" />
    <button class="rounded-2xl bg-white px-4 py-3 text-black hover:bg-white/90" type="submit">
        Submit
    </button>
    </form>
</section>