---
// Универсальный Embla-слайдер: слайды передаются через <slot />.
// slideClass задаёт ширину слайда (flex-basis) для конкретного использования.
// loop=false: слайдер стоит на первом слайде и не перескакивает с начала в конец.
// perSlide/cols — сколько карточек и колонок на слайде для [base, sm, lg].
// Рядов получается perSlide / cols; пересборка слайдов идёт на клиенте при смене брейкпоинта.
const {
  slideClass = "flex-[0_0_66.666%]",
  loop = false,
  perSlide = null,
  cols = null,
} = Astro.props;
---

<div
  class="select-none w-full relative"
  data-slider
  data-loop={loop ? "true" : "false"}
  data-per-slide={perSlide ? perSlide.join(",") : undefined}
  data-cols={cols ? cols.join(",") : undefined}
>
  <div class="overflow-hidden w-full touch-pan-y" data-embla-viewport>
    <!-- items-start: неполный слайд не растягивается по высоте самого высокого -->
    <div class="flex items-start gap-6" data-embla-container data-slide-class={slideClass}>
      <slot />
    </div>
  </div>

  <button
    type="button"
    class="absolute left-3 top-1/2 -translate-y-1/2 rounded-full border border-white/20 bg-black/30 px-4 py-3 text-sm text-white backdrop-blur transition hover:bg-black/45 cursor-pointer"
    data-embla-prev
    aria-label="Назад"
  >
    ←
  </button>

  <button
    type="button"
    class="absolute right-3 top-1/2 -translate-y-1/2 rounded-full border border-white/20 bg-black/30 px-4 py-3 text-sm text-white backdrop-blur transition hover:bg-black/45 cursor-pointer"
    data-embla-next
    aria-label="Вперёд"
  >
    →
  </button>
</div>

<script>
  import EmblaCarousel from "embla-carousel";

  document.querySelectorAll<HTMLElement>("[data-slider]").forEach((root) => {
    const viewport = root.querySelector<HTMLElement>("[data-embla-viewport]");
    if (!viewport) return;

    const prevBtn = root.querySelector<HTMLButtonElement>("[data-embla-prev]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-embla-next]");

    const embla = EmblaCarousel(viewport, {
      loop: root.dataset.loop === "true",
      align: "start",
      startIndex: 0,
      containScroll: "trimSnaps",
      dragFree: false,
      watchDrag: true,
    });

    prevBtn?.addEventListener("click", () => embla.scrollPrev());
    nextBtn?.addEventListener("click", () => embla.scrollNext());

    // Без loop стрелка на краю ничего не делает — гасим её, чтобы это было видно.
    const syncArrows = () => {
      prevBtn?.classList.toggle("opacity-30", !embla.canScrollPrev());
      prevBtn?.classList.toggle("pointer-events-none", !embla.canScrollPrev());
      nextBtn?.classList.toggle("opacity-30", !embla.canScrollNext());
      nextBtn?.classList.toggle("pointer-events-none", !embla.canScrollNext());
    };

    syncArrows();
    embla.on("select", syncArrows).on("reInit", syncArrows);

    // Пересборка слайдов под брейкпоинт: рядов всегда одинаково, меняется число колонок.
    const perSlide = (root.dataset.perSlide ?? "").split(",").map(Number);
    const colsPerBp = (root.dataset.cols ?? "").split(",").map(Number);
    const container = viewport.firstElementChild as HTMLElement | null;

    if (perSlide.length === 3 && colsPerBp.length === 3 && container) {
      const colsClass: Record<number, string> = {
        1: "grid-cols-1",
        2: "grid-cols-2",
        3: "grid-cols-3",
      };

      // Карточки, как их отрендерил сервер (уже сгруппированные в слайды).
      const cards = [...container.children].flatMap((child) =>
        child.hasAttribute("data-slide-group") ? [...child.children] : [child],
      );

      const smQuery = window.matchMedia("(min-width: 640px)");
      const lgQuery = window.matchMedia("(min-width: 1024px)");

      const breakpoint = () => (lgQuery.matches ? 2 : smQuery.matches ? 1 : 0);

      let currentBp = -1;

      const relayout = () => {
        const bp = breakpoint();
        if (bp === currentBp) return;
        currentBp = bp;

        const size = perSlide[bp];
        const slides: HTMLElement[] = [];

        for (let i = 0; i < cards.length; i += size) {
          const slide = document.createElement("div");
          slide.setAttribute("data-slide-group", "");
          slide.className = `min-w-0 flex-[0_0_100%] grid gap-6 ${colsClass[colsPerBp[bp]]}`;
          slide.append(...cards.slice(i, i + size));
          slides.push(slide);
        }

        container.replaceChildren(...slides);
        embla.reInit();
      };

      relayout();
      smQuery.addEventListener("change", relayout);
      lgQuery.addEventListener("change", relayout);
      window.addEventListener("resize", relayout);
    }

    let wheelTimeout: number | null = null;
    let isScrolling = false;
    const SWIPE_THRESHOLD = 50;

    viewport.addEventListener("wheel", (e: WheelEvent) => {
      if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) return;

      e.preventDefault();
      if (isScrolling) return;

      if (Math.abs(e.deltaX) > SWIPE_THRESHOLD) {
        isScrolling = true;

        if (e.deltaX > 0) {
          embla.scrollNext();
        } else {
          embla.scrollPrev();
        }

        if (wheelTimeout !== null) clearTimeout(wheelTimeout);

        wheelTimeout = window.setTimeout(() => {
          isScrolling = false;
          wheelTimeout = null;
        }, 300);
      }
    }, { passive: false });
  });
</script>
