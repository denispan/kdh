---
import { platforms, type Track } from "../data/music";
import type { Release } from "../data/releases";

type Props = {
  track: Track;
  release?: Release;
};

const { track, release } = Astro.props;

const cover = release?.cover ?? track.colorLogo;
const links = platforms.filter((p) => track.links[p.key]);
---

<article class="relative min-w-0 rounded-2xl bg-white/[0.06] p-4 ring-1 ring-white/10 transition duration-300 hover:-translate-y-1 hover:bg-white/10 hover:ring-white/20">
  <div class="flex items-center gap-4">
    <div class="relative h-[72px] w-[72px] shrink-0">
      <img
        src={cover}
        alt=""
        width="72"
        height="72"
        class="h-full w-full rounded-xl object-cover"
        loading="lazy"
        decoding="async"
      />

      {release?.preview && (
        <button
          type="button"
          class="absolute inset-0 grid cursor-pointer place-items-center rounded-xl bg-black/40 text-white transition hover:bg-black/60"
          data-preview={release.preview}
          data-playing="false"
          aria-pressed="false"
          aria-label={`Послушать 30 секунд: ${track.title}`}
        >
          <svg class="play-icon h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
          <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
      )}
    </div>

    <div class="min-w-0 flex-1">
      <h3 class="truncate font-display text-base font-bold leading-tight text-white">{track.title}</h3>
      {track.original && <p class="mt-1 truncate text-xs text-white/50">оригинал — {track.original}</p>}

      <div class="mt-3 flex items-center gap-2">
        {links.map((p) => (
          <a
            href={track.links[p.key]}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${track.title} — ${p.label}`}
            class="group inline-flex h-9 w-9 items-center justify-center rounded-lg bg-white/5 ring-1 ring-white/10 transition hover:bg-white/15"
          >
            <img
              src={p.iconSrc}
              alt=""
              class="h-5 w-5 object-contain grayscale transition group-hover:grayscale-0"
              loading="lazy"
              decoding="async"
            />
          </a>
        ))}
      </div>
    </div>
  </div>
</article>
