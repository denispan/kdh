---
import { platforms, type Track } from "../data/music";
import type { Release } from "../data/releases";

type Props = {
  track: Track;
  release?: Release;
};

const { track, release } = Astro.props;

const cover = release?.cover ?? track.colorLogo;
const links = platforms.filter((p) => track.links[p.key]);
---

<article class="relative min-w-0 rounded-2xl border border-white/10 bg-black/20 p-5 shadow-2xl ring-1 ring-white/10 backdrop-blur transition hover:bg-black/30">
  <div class="flex items-center gap-4">
    <div class="relative h-16 w-16 shrink-0">
      <img
        src={cover}
        alt=""
        width="64"
        height="64"
        class="h-full w-full rounded-xl object-cover ring-1 ring-white/10"
        loading="lazy"
        decoding="async"
      />

      {release?.preview && (
        <button
          type="button"
          class="preview-toggle absolute inset-0 cursor-pointer rounded-xl"
          data-preview={release.preview}
          data-playing="false"
          aria-pressed="false"
          aria-label={`Послушать 30 секунд: ${track.title}`}
        >
          <!-- маленький значок в углу — подсказка, что обложку можно послушать -->
          <span class="preview-badge absolute bottom-1 right-1 grid h-5 w-5 place-items-center rounded-full bg-black/70 text-white" aria-hidden="true">
            <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
          <!-- затемнение с большой иконкой/эквалайзером — при наведении и во время воспроизведения -->
          <span class="preview-state absolute inset-0 grid place-items-center rounded-xl bg-black/55 text-white" aria-hidden="true">
            <svg class="play-icon h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
            <span class="eq"><i></i><i></i><i></i></span>
          </span>
        </button>
      )}
    </div>

    <div class="min-w-0 flex-1">
      <h3 class="truncate text-lg font-medium">{track.title}</h3>
      {track.original && <p class="mt-0.5 truncate text-xs text-white/60">оригинал — {track.original}</p>}

      <div class="mt-3 flex items-center gap-2">
        {links.map((p) => (
          <a
            href={track.links[p.key]}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${track.title} — ${p.label}`}
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-black/30 ring-1 ring-white/10 transition hover:bg-black/45"
          >
            <img src={p.iconSrc} alt="" class="h-5 w-5 object-contain" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </div>
  </div>
</article>
