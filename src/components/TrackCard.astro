---
import { platforms, type Track } from "../data/music";
import type { Release } from "../data/releases";
import { isLightColor } from "../lib/color";

type Props = {
  track: Track;
  release?: Release;
};

const { track, release } = Astro.props;

// Карточка красится в цвет обложки сингла; текст и чипы подстраиваются под яркость фона.
const color = release?.color ?? "#2b0f66";
const tone = isLightColor(color)
  ? { text: "text-black", muted: "text-black/60", chip: "bg-black/10 ring-black/10 hover:bg-black/20" }
  : { text: "text-white", muted: "text-white/70", chip: "bg-black/30 ring-white/10 hover:bg-black/45" };

const cover = release?.cover ?? track.colorLogo;
const links = platforms.filter((p) => track.links[p.key]);
---

<article
  class={`relative min-w-0 overflow-hidden rounded-2xl p-4 ring-1 ring-white/10 transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_40px_-24px_rgba(0,0,0,0.9)] ${tone.text}`}
  style={`background-color: ${color}`}
>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white/15 via-transparent to-black/30" aria-hidden="true"></div>

  <div class="relative flex items-center gap-4">
    <div class="relative h-[72px] w-[72px] shrink-0">
      <img
        src={cover}
        alt=""
        width="72"
        height="72"
        class="h-full w-full rounded-xl object-cover shadow-lg"
        loading="lazy"
        decoding="async"
      />

      {release?.preview && (
        <button
          type="button"
          class="absolute inset-0 grid cursor-pointer place-items-center rounded-xl bg-black/35 text-white transition hover:bg-black/55"
          data-preview={release.preview}
          data-playing="false"
          aria-pressed="false"
          aria-label={`Послушать 30 секунд: ${track.title}`}
        >
          <svg class="play-icon h-7 w-7 drop-shadow" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
          <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
      )}
    </div>

    <div class="min-w-0 flex-1">
      <h3 class="truncate font-display text-base font-bold leading-tight">{track.title}</h3>
      {track.original && <p class={`mt-1 truncate text-xs ${tone.muted}`}>оригинал — {track.original}</p>}

      <div class="mt-3 flex items-center gap-2">
        {links.map((p) => (
          <a
            href={track.links[p.key]}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${track.title} — ${p.label}`}
            class={`inline-flex h-9 w-9 items-center justify-center rounded-lg ring-1 transition ${tone.chip}`}
          >
            <img src={p.iconSrc} alt="" class="h-5 w-5 object-contain" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </div>
  </div>
</article>
