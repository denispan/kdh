---

{
  name === "ok" ? (
    <svg viewBox="0 0 24 24" class={className} aria-hidden="true">
      <circle cx="12" cy="12" r="11" fill="currentColor" />
      <text x="12" y="15.5" text-anchor="middle" font-size="9" font-weight="700" font-family="system-ui, sans-serif" fill="#fff">
        OK
      </text>
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" class={className} fill="currentColor" aria-hidden="true">
      <path d={paths[name]} />
    </svg>
  )
}
