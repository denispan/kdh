---
// src/components/Header.astro
const navLinks = [
  { href: "#top", label: "Главная" },
  { href: "#photos", label: "Фото" },
  { href: "#video", label: "Видео" },
  { href: "#contacts", label: "Контакты" },
];
---

<header class="sticky top-0 z-50 w-full">
  <div class="bg-black/85 backdrop-blur">
    <div class="mx-auto max-w-6xl px-6 pt-[10px]">
      <!-- Row 1: logo centered -->
      <div class="flex h-16 items-center justify-center">
        <a href="#top" class="inline-flex h-full items-center justify-center">
          <img
            src="/logo.svg"
            alt="Logo"
            class="h-full w-auto"
            decoding="async"
            loading="eager"
          />
        </a>
      </div>

      <div class="h-px w-full bg-white/10"></div>

      <!-- Row 2: menu -->
      <nav class="flex flex-wrap items-center justify-center gap-x-10 gap-y-3 py-4 text-xs uppercase tracking-[0.22em] text-white">
        {navLinks.map((l) => (
          <a class="hover:opacity-80" href={l.href}>
            {l.label}
          </a>
        ))}
      </nav>

      <div class="h-px w-full bg-white/10"></div>
    </div>
  </div>
</header>
