---
// src/components/Header.astro
const navLinksLeft = [
  { href: "#music", label: "Музыка" },
  { href: "#photos", label: "Фото" },

];

const navLinksRight = [
  { href: "#video", label: "Видео" },
  { href: "#contacts", label: "Контакты" },
];
---

<header class="fixed inset-x-0 top-0 z-50 w-full">
  <div class="bg-black/30 backdrop-blur">
    <div class="mx-auto max-w-6xl px-6 pt-[10px] pb-3">
      <div class="grid h-16 grid-cols-3 items-center">
        <nav class="flex items-center justify-start gap-12 text-s font-bold uppercase tracking-[0.22em] text-white">
          {navLinksLeft.map((l) => (
            <a class="hover:opacity-80" href={l.href}>
              {l.label}
            </a>
          ))}
        </nav>

        <a href="#music" class="mx-auto inline-flex h-full items-center justify-center">
          <img src="/logo.svg" alt="Logo" class="h-full w-auto" decoding="async" loading="eager" />
        </a>

        <nav class="flex items-center justify-end gap-12 text-s font-bold uppercase tracking-[0.22em] text-white">
          {navLinksRight.map((l) => (
            <a class="hover:opacity-80" href={l.href}>
              {l.label}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</header>
